				{
					"Image": "imgs/actions/flip-model/key-on",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Change Expression",
			"UUID": "com.coffeesanvt.yaps-streamdeck-integration.change-expression",
			"Icon": "imgs/actions/expression/icon",
