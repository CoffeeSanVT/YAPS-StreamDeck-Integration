			"PropertyInspectorPath": "ui/expression.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/expression/key-off",
					"TitleAlignment": "bottom"
				},
				{
					"Image": "imgs/actions/expression/key-on",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Toggle Asset",
			"UUID": "com.coffeesanvt.yaps-streamdeck-integration.toggle-asset",
			"Icon": "imgs/actions/items/icon",
